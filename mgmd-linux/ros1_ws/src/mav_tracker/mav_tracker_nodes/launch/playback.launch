<launch>
  <!-- S3.5：用本地视频回放驱动，无需硬件。
       用法：
         roslaunch mav_tracker_nodes playback.launch video:=phantom30
         roslaunch mav_tracker_nodes playback.launch video:=phantom30 rate:=30 limit:=300
         roslaunch mav_tracker_nodes playback.launch video:=/abs/path.mp4 rate:=0   (原始帧率) -->

  <arg name="video"   default="phantom30"/>
  <arg name="rate"    default="30"/>
  <arg name="loop"    default="true"/>
  <arg name="limit"   default="0"/>

  <node pkg="mav_tracker_nodes" type="tt_driver.py" name="tt_driver" output="screen">
    <param name="source" value="file"/>
    <param name="path"   value="$(arg video)"/>
    <param name="rate"   value="$(arg rate)"/>
    <param name="loop"   value="$(arg loop)"/>
    <param name="limit"  value="$(arg limit)"/>
  </node>

  <node pkg="mav_tracker_nodes" type="mav_node.py"     name="mav_node"     output="screen"/>
  <node pkg="mav_tracker_nodes" type="tracker_node.py" name="tracker_node" output="screen"/>
  <node pkg="mav_tracker_nodes" type="viz_node.py"     name="viz_node"     output="screen"/>
</launch>
