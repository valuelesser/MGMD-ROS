<launch>
  <!-- 视频目标跟踪主 launch（三节点方案，SPEC-ROS §17.2）
       用法：
         roslaunch mav_tracker_nodes track.launch video:=phantom30
         roslaunch mav_tracker_nodes track.launch video:=phantom30 rate:=30 limit:=600
         roslaunch mav_tracker_nodes track.launch video:=/abs/path.mp4 out_video:=/tmp/a.mp4
  -->

  <arg name="video"     default="phantom30"/>
  <arg name="rate"      default="30"/>
  <arg name="loop"      default="true"/>
  <arg name="limit"     default="0"/>
  <arg name="width"     default="960"/>
  <arg name="height"    default="720"/>

  <arg name="device"    default="cuda"/>
  <arg name="d_min"     default="0.02"/>
  <arg name="buffer"    default="6"/>
  <arg name="frame_delta_predict" default="true"/>
  <arg name="association_radius_factor" default="2.0"/>

  <!-- 默认输出到项目根 outputs/ros_viz/（可用 out_video:= 覆盖） -->
  <arg name="out_video" default="/home/gaoduan/毕业设计/mgmd-linux/outputs/ros_viz/track.mp4"/>
  <arg name="encoder"   default="nvenc"/>
  <arg name="visualize" default="true"/>

  <!-- roslaunch 用管道接管 stdout 会触发 Python 块缓冲，导致日志不可见。
       统一开 PYTHONUNBUFFERED，否则节点看似"没启动"（SPEC-ROS §23.3.2）。 -->
  <env name="PYTHONUNBUFFERED" value="1"/>

  <!-- 1) 视频源 -->
  <node pkg="mav_tracker_nodes" type="video_source.py" name="video_source" output="screen">
    <param name="source" value="file"/>
    <param name="path"   value="$(arg video)"/>
    <param name="rate"   value="$(arg rate)"/>
    <param name="loop"   value="$(arg loop)"/>
    <param name="limit"  value="$(arg limit)"/>
    <param name="width"  value="$(arg width)"/>
    <param name="height" value="$(arg height)"/>
  </node>

  <!-- 2) 检测（MFE → TF → LAC → LAD） -->
  <node pkg="mav_tracker_nodes" type="detector_node.py" name="detector_node" output="screen">
    <param name="device"      value="$(arg device)"/>
    <param name="d_min"       value="$(arg d_min)"/>
    <param name="buffer_size" value="$(arg buffer)"/>
    <param name="frame_delta_predict" value="$(arg frame_delta_predict)"/>
    <param name="association_radius_factor" value="$(arg association_radius_factor)"/>
  </node>

  <!-- 3) 可视化：写带框视频 -->
  <node if="$(arg visualize)" pkg="mav_tracker_nodes" type="visualize_node.py"
        name="visualize_node" output="screen">
    <param name="out" value="$(arg out_video)"/>
    <param name="fps" value="$(arg rate)"/>
    <param name="encoder" value="$(arg encoder)"/>
  </node>
</launch>
