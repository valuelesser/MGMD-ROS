# 原始数据（体积大，不纳入版本控制）
data_raw/
tracking/data_raw/
mgmd-linux/data_derived/

# 环境（本地 bootstrap，含 numpy/cv2/scipy/pytest）
.bootstrap/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# 运行产物
mgmd-linux/outputs/runs/
mgmd-linux/outputs/logs/
# 演示视频不入库（SPEC §0 V6 / 用户决策 2026-10-28）
# 交付时用 scripts/pack_deliverables.sh 单独打包到 deliverables/
mgmd-linux/outputs/figures/
outputs/**/*.pt
outputs/**/*.pth
outputs/**/*.ckpt
*.log

# 交付包（含视频，单独分发，不进版本控制）
deliverables/

# 系统文件
.DS_Store
Thumbs.db

# TRT engine 与 ONNX（体积大，且 engine 绑定 GPU 架构/TRT 版本，需本机重建）
mgmd-linux/outputs/*.engine
mgmd-linux/outputs/*.onnx

# ROS1 catkin 编译产物
mgmd-linux/ros1_ws/build/
mgmd-linux/ros1_ws/devel/
mgmd-linux/ros1_ws/install/
mgmd-linux/ros1_ws/.catkin_workspace

# Python 3.8 venv（ONNX 环境，体积大不入库）
mgmd-linux/.venv38/

# 工具缓存（2026-10-30：git add -A 曾误收 2GB 的 .cache 内容）
.cache/
.uv/
.onnxruntime/

# 测量明细（本地产物，由 scripts/measure_stages.sh 生成）
mgmd-linux/outputs/timing/
*.csv.tmp
